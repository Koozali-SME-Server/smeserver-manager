my $navigation_ignore = "(\.\.?|Swttheme\.pm|Login\.pm|Request\.pm|Modules\.pm(-.*)?)";


my $i18n_db    = new esmith::I18N;
our $i18n_plugin = SrvMngr::Plugin::I18N::_Handler->new();

# These are the attributes Mojolicious normally sets during register()
$i18n_plugin->{namespace} = 'SrvMngr::Plugin::I18N';
$i18n_plugin->{default}   = 'en';
#$i18n_plugin->{mo_root}   = '/usr/share/smanager/lib/SrvMngr/I18N/po';

# Verify class
