use constant WEBFUNCTIONS  => 'SrvMngr/Controller';
use constant NAVDIR        => '/home/e-smith/db';
use constant NAVIGATIONDIR => 'navigation2';
use constant TEMPLATEDIR   => '/usr/share/smanager/themes/default/templates/';
