sub Find_prefix_from_po_file {
    my $pofile = shift;
    
    # Open the PO file for reading
    open(my $fh, '<', $pofile) or return undef;
    
    my $prefix = undef;
    
    while (my $line = <$fh>) {
        chomp $line;
        
        # Skip comment lines (starting with #)
        next if $line =~ /^\s*#/;
        
        # Skip empty lines
        next if $line =~ /^\s*$/;
        
        # Look for msgid lines
        if ($line =~ /^msgid\s+"([^"]*)"/) {
            my $msgid = $1;
            
            # Skip if msgid is empty
            next if $msgid eq '';
            
            # Check if msgid has the prefix format <letters_or_numbers>_<the_rest>
            if ($msgid =~ /^([a-zA-Z0-9]+)_(.*)$/) {
                $prefix = $1;
                last;  # Found first valid prefix, exit loop
            }
        }
    }
    
    close($fh);
    return $prefix;
}

# ---------------------------------------------------------------------------
# Reduce a Mojolicious .ep template to just its embedded Perl, blanking out
# everything else but keeping every newline so extracted line numbers still
# point at the right spot in the original .ep file. Tested against real
# smeserver-manager templates, including the two comment conventions that
# must NOT leak a key: a whole Perl-comment line ('%# ...') and the
# '<%#= ... %>' idiom for temporarily disabling what used to be an output
# tag -- both are genuine Mojolicious comments, never evaluated or rendered.
# ---------------------------------------------------------------------------
sub strip_to_perl {
    my ($text) = @_;
    my @lines = split /\n/, $text, -1;
    my @out;

    for my $line (@lines) {
        if ( $line =~ /^\s*%\s*#/ ) {
            push @out, '';
            next;
        }
        if ( $line =~ /^\s*%(?!%)(.*)$/ ) {
            push @out, $1;
            next;
        }
        ( my $no_comments = $line ) =~ s/<%#.*?%>//gs;
        my $kept = '';
        while ( $no_comments =~ /<%={0,2}\s*(.*?)\s*%>/gs ) {
            $kept .= $1 . ';';
        }
        push @out, $kept;
    }
    return join( "\n", @out );
}

sub Find_prefix_from_mojolicious_file {
	# Subroutine: Find_prefix_from_mojolicious_file
    # Returns the most frequent valid prefix found in the file
    my $mojoliciousfile = shift;

    return undef unless -f $mojoliciousfile;

    # Initialize extractor (matching working snippet)
    my $Ext = Locale::Maketext::Extract->new(
        warnings => 0,
        verbose  => 0,
    );

    # Extract msgid's from file
	if ( $mojoliciousfile =~ /\.ep$/ ) {
		#Mojolicious template file
		open my $fh, '<:encoding(UTF-8)', $mojoliciousfile or die "Cannot open $mojoliciousfile: $!";
		local $/;
		my $raw = <$fh>;
		close $fh;
		$Ext->extract( $mojoliciousfile => strip_to_perl($raw) );
	}
	else {
		#Mojolicious mojolicious file
		$Ext->extract_file($mojoliciousfile);
	}

    $Ext->extract_file($mojoliciousfile) or return undef;

    # Compile and write to temp PO file (required for this module version)
    $Ext->compile;

    my ($tfh, $tpath) = tempfile();
    close($tfh);

    $Ext->write_po($tpath); #Returns false even if works, but can't find all the plugins

    my %prefix_counts;

    open(my $rfh, '<:encoding(UTF-8)', $tpath) or do {
        unlink $tpath;
        return undef;
    };

    while (my $line = <$rfh>) {
        # Match msgid lines
        if ($line =~ /^msgid "((?:[^"\\]|\\.)*)"/) {
            my $key = $1;
            next if $key eq '';

            # Unescape standard PO escapes
            $key =~ s/\\"/"/g;
            $key =~ s/\\\\/\\/g;

            # Check if key has valid prefix format
            if ($key =~ /^([a-zA-Z0-9]+)_(.*)$/) {
                $prefix_counts{$1}++;
            }
        }
    }

    close($rfh);
    unlink $tpath;

    return undef unless %prefix_counts;

    # Find prefix with the highest count
    my ($best_prefix, $best_count) = (undef, 0);
    while (my ($prefix, $count) = each %prefix_counts) {
        if ($count > $best_count) {
            $best_prefix = $prefix;
            $best_count = $count;
        }
    }

    return $best_prefix;
}

sub Find_prefix_from_lex_file {
    my ($lexfile) = @_;
    my $lang = 'en'; #only need one lex file to do it.
    # Extract prefix from lex file 
    my $long_lex = $lexfile;

    my @panel_lex;
    if (-e $long_lex) {
        open(my $LEX, '<:encoding(UTF-8)', $long_lex)
            or die "Couldn't open ", $long_lex, " for reading.\n";
        @panel_lex = <$LEX>;
        close $LEX;
    }

    # Extract the prefix for this module
    my @keys   = values @panel_lex;    # Get all values from the array
    my $i      = 0;                    # Initialize the index
    my $found  = 0;                    # Flag to check if the prefix was found
    my $prefix;                

    # Look for the prefix in the lex file
    while ($i < @keys) {               # Loop until we run out of entries
        my $extracted_value = $keys[$i] || "";    # The current entry
        #print("Extracted val: ".$extracted_value."\n");

        # Extract prefix from the second value (up to and including the first underscore)
        #my ($prefix) = $second_value =~ /^'(.*?_)/;  # Match everything up to and including the first underscore
        ($prefix) = $extracted_value =~ /^'(.*?_)/;    # Match everything up to and including the first underscore

        if (defined $prefix) {
            $found = 1;                                # Set found flag to true
            last;                                      # Exit the loop if prefix is found
        } else {
            #print("Extracted Val: " . $extracted_value . "\n");
        }
        $i++;                                          # Increment the index to check the next entry
    } ## end while ($i < @keys)

    if (!$found) {
        print(STDERR "No valid prefix found in any entries: " . $lexfile . " (" . $lang . ")\n") if DEBUG;
        $prefix = undef;    # Probably never match!!
    }
    
    return $prefix;
}

# Enhanced helper function for advanced quote handling
sub parse_advanced_quoted_string {
    my ($str) = @_;
    
    # Remove leading/trailing whitespace
    $str =~ s/^\s+|\s+$//g;
    
    # Handle empty string case
    return "" if !$str || $str eq "";
    
    # Check what type of quotes are used (single or double)
    my $quote_char = substr($str, 0, 1);
    
    # If first character is not a quote, return as-is
    return $str unless ($quote_char eq "'" || $quote_char eq '"');
    
    # Check if string starts and ends with the same quote type
    my $last_quote_pos = rindex($str, $quote_char);
    return $str if $last_quote_pos <= 0;  # No closing quote
    
    # Extract content between quotes
    my $content = substr($str, 1, $last_quote_pos - 1);
    
    # Handle escaped quotes within the string (more sophisticated approach)
    # This handles cases like: 'He said \'Hello\' to me'
    if ($quote_char eq "'") {
        # Remove backslash-escaped quotes
        $content =~ s/\\(['"])/$1/g;
    } elsif ($quote_char eq '"') {
        # Remove backslash-escaped quotes  
        $content =~ s/\\(['"])/$1/g;
    }
    
    return $content;
}



#1. localise
#
# Replaces the manual lc() hash lookup with the Handler's localization logic.
sub localise {
    my ($string) = @_;
    $string //= '';


    # Call the handler's localization method.
    # The underlying Locale::Maketext::Lexicon fallbacks automatically (returning $key if not found),
    # which mirrors the old behavior ($lexicon->{key} ||  $key).
    return $i18n_plugin->localize($string);
}

# 2. process_localization
# Replaces manual conditional logic with the I18N system's native lookup.
sub process_localization {
    my ($namespace, $heading, $lang, $prefix) = @_;
    print "Heading:$heading Language:$lang Prefix:$prefix\n" if DEBUG;
  
    # 1. Normalize language code (remove region part if exists)
    my $base_lang = $lang ? (split('-', $lang))[0] : 'en';
    print "Base lang:$base_lang\n" if DEBUG;
    # 2. Set language in the handler
    $i18n_plugin->languages($base_lang);

    # Get the current active language tag from the handler
    #my $lang = $i18n_plugin->languages;

    # Ensure the handler is configured for this specific language/namespace
    $i18n_plugin->i18namespace($namespace, $base_lang);


    # 3. Try the raw heading first
    my $loc_heading = localise($heading);
    print "Raw:$loc_heading\n" if DEBUG;

    # 4. Fallback logic if heading wasn't translated and target language is not English
    if ($loc_heading eq $heading && $base_lang ne 'en' && defined $prefix) {
        # 5. Try prefix + heading (standard I18N namespace/key pattern)
        my $key = $prefix . $heading;
        my $tr = localise($key);
        print "Try prefix:$key giving: $tr\n" if DEBUG;

        # If the prefix key also failed (returned exactly the key), revert to original heading
        $loc_heading = $heading if $tr eq $key;
    }

    return $loc_heading;
}


